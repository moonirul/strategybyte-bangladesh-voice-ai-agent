# ByteVoice Bangladesh — FastAPI Backend Environment Example
# Copy to .env for local development. Never commit real credentials.

APP_ENV=development
APP_VERSION=0.1.0

# Comma-separated allowed CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000

# Demo clinic slug used for public simulated calls from the landing page
DEMO_CLINIC_SLUG=dhaka-dental-care

# Storage backend:
#   "supabase" = persist to Supabase PostgreSQL (required for production / live Supabase demo)
#   "memory"   = deterministic in-memory repository pre-seeded with Dhaka Dental Care demo records
#                (automatically used in automated tests or when SUPABASE_URL is unset in development)
STORAGE_BACKEND=memory

# Supabase configuration (Keep SUPABASE_SERVICE_ROLE_KEY strictly on the backend server)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Secret used to sign per-call tokens for public /api/demo-calls endpoints
DEMO_CALL_TOKEN_SECRET=change-me-in-production-min-32-chars

# Optional shared secret for verifying incoming POST /api/webhooks/vapi payloads
VAPI_WEBHOOK_SECRET=
